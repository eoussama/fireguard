		"@eslint/js": "^10.0.1",
		"@types/chroma-js": "^3.1.2",
		"@types/eslint": "^9.6.1",
		"eslint": "^10.5.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^17.7.0",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^4.1.1",
		"sass": "^1.69.7",
		"svelte": "^5.55.7",
		"svelte-check": "^4.0.0",
		"tslib": "^2.4.1",
