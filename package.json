{
  "name": "fireguard",
  "type": "module",
  "version": "0.1.3",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "lint": "dx lint",
    "lint:fix": "dx lint --fix",
    "prod": "pnpm audit && pnpm lint && pnpm check && pnpm build && pnpm test"
  },
  "dependencies": {
    "@eoussama/core": "^0.0.4",
    "@eoussama/firemitt": "^0.1.5",
    "chroma-js": "^3.2.0",
    "firebase": "^12.15.0"
  },
  "devDependencies": {
    "@eoussama/dx": "^0.0.4",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.68.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/chroma-js": "^3.1.2",
    "sass": "^1.69.7",
    "svelte": "^5.55.7",
    "svelte-check": "^4.0.0",
    "tslib": "^2.4.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
